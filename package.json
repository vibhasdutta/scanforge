{
  "name": "scanforge-audit",
  "version": "1.0.1",
  "description": "Runs Lighthouse across an entire page journey at once instead of one URL at a time — queue multiple pages, audit them concurrently, and get one focused Markdown report your AI coding tool can act on to fix what's broken.",
  "private": false,
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "bin": {
    "scanforge": "./bin/scanforge.js"
  },
  "scripts": {
    "start": "node bin/scanforge.js",
    "companion": "node bin/scanforge.js",
    "postinstall": "node scripts/register-native-host.js",
    "register": "node scripts/register-native-host.js",
    "companion:register": "node scripts/register-native-host.js",
    "unregister": "node scripts/unregister-native-host.js",
    "companion:unregister": "node scripts/unregister-native-host.js",
    "build": "node build.js",
    "prepublishOnly": "node build.js",
    "test": "node --test test/security.test.js",
    "assets:prepare": "powershell -ExecutionPolicy Bypass -File scripts/prepare-approved-icons.ps1",
    "package:extension": "npm run assets:prepare && npm run build && powershell -ExecutionPolicy Bypass -File scripts/package-extension.ps1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "chrome-launcher": "^1.2.1",
    "ink": "^7.1.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^4.0.1",
    "ink-link": "^5.0.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "lighthouse": "^13.4.1",
    "puppeteer-core": "25.7.0",
    "react": "^19.2.8"
  }
}
