# .npmignore, if present, REPLACES .gitignore for npm's file-selection — it does not add
# to it. This deliberately mirrors most of .gitignore's exclusions, but two entries are the
# opposite of what git wants: dist/ is gitignored (rightly — it's build output, not source)
# but MUST ship here, since bin/scanforge.js loads dist/cli.js directly and npm-installed
# users have no dev dependencies to build it themselves. bin/ is also NOT excluded wholesale
# (unlike .gitignore's blanket [Bb]in/) since bin/scanforge.js is the package's own entry
# point — only the compiled .exe launchers underneath it are excluded, further below.

node_modules/
[Oo]bj/

# Browser-extension release zips and native-build intermediates — irrelevant to the npm CLI
# package, and .tools/ in particular is a multi-hundred-MB local .NET SDK download that must
# never be published.
release/
desktop-release/
native-release/
.tools/

# Generated Lighthouse and ScanForge reports
*.report.html
*.report.json
*.lhr.json
scanforge-*.md

# Runtime files and logs
*.log
logs/
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment files
.env
.env.*
!.env.example

# Test and coverage output
coverage/
.nyc_output/
test/

# Editor and operating-system files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.cache

# Machine-specific, regenerated by postinstall (scripts/register-native-host.js) — shipping
# a stale value from whichever machine ran "npm publish" would be wrong for every installer.
node_bin.txt

# Windows-only compiled launchers. scanforge-companion.exe is rebuilt automatically by
# postinstall if missing (ensureCompanionLauncher in register-native-host.js), so shipping a
# pre-built copy just adds dead weight on macOS/Linux installs. scanforge.exe is a standalone
# convenience binary, not needed for the "scanforge" command itself — that goes through
# bin/scanforge.js via npm's own bin-shimming.
bin/*.exe
